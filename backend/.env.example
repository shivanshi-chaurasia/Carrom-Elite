# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
HOST=0.0.0.0
REQUEST_TIMEOUT=30000

# ==========================================
# DATABASE - PostgreSQL
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/carrom_lottery?schema=public

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=carrom-lottery-api

# ==========================================
# BCRYPT
# ==========================================
BCRYPT_SALT_ROUNDS=12

# ==========================================
# CLOUDINARY
# ==========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=carrom-lottery

# ==========================================
# SMTP - NODEMAILER
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@carromlottery.com

# ==========================================
# FIREBASE CLOUD MESSAGING
# ==========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ==========================================
# OTP
# ==========================================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
MAX_OTP_ATTEMPTS=5

# ==========================================
# UPLOAD
# ==========================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_CREDENTIALS=true

# ==========================================
# CURRENCY
# ==========================================
CURRENCY=INR
MIN_DEPOSIT=10
MAX_DEPOSIT=100000
MIN_WITHDRAWAL=50
MAX_WITHDRAWAL=50000

# ==========================================
# REFERRAL
# ==========================================
REFERRAL_BONUS_AMOUNT=50
REFERRAL_MIN_WITHDRAWAL=100
REFERRAL_CODE_LENGTH=8

# ==========================================
# LOTTERY
# ==========================================
LOTTERY_TICKET_PRICE=10
LOTTERY_MAX_TICKETS_PER_USER=100
LOTTERY_DRAW_INTERVAL_MINUTES=1440
LOTTERY_JACKPOT_PERCENTAGE=50

# ==========================================
# MATCH
# ==========================================
MATCH_TIMEOUT_MINUTES=5
MAX_PLAYERS_PER_ROOM=4
MINIMUM_ENTRY_FEE=0

# ==========================================
# REWARDS
# ==========================================
DAILY_REWARD_COINS=10
WEEKLY_REWARD_COINS=100
VIP_BONUS_PERCENTAGE=20

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30

# ==========================================
# BULLMQ
# ==========================================
BULLMQ_PREFIX=carrom
BULLMQ_DEFAULT_JOBS=10
BULLMQ_RETRY_DELAY=5000
BULLMQ_MAX_RETRIES=3
